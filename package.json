{
  "name": "ambree-qloo",
  "version": "0.1.0",
  "description": "Ambree Taste Planner: an MCP server that turns a traveller's tastes into a day in Mauritius with Qloo's Taste AI, plus a demo page that is a real MCP client.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "homepage": "https://qloo.ambree.ai",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
